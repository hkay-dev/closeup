@@ -0,0 +1,95 @@
+package com.genymobile.scrcpy.video;
+
+import com.genymobile.scrcpy.FakeContext;
+import com.genymobile.scrcpy.util.Ln;
+
+import android.content.Context;
+import android.hardware.Sensor;
+import android.hardware.SensorEvent;
+import android.hardware.SensorEventListener;
+import android.hardware.SensorManager;
+import android.os.Handler;
+
+/**
+ * Reports which way up the phone is held, from the accelerometer, so the computer can turn the picture upright.
+ * The angle is computed like android.view.OrientationEventListener's; while the phone lies flat, the last turn holds.
+ */
+public final class WebcamOrientation implements SensorEventListener {
+
+    public interface Listener {
+        /**
+         * @param device the phone's clockwise quarter turns from its natural position, or -1 while unknown
+         * @param sensor the camera's SENSOR_ORIENTATION in quarter turns
+         */
+        void onOrientation(int device, int sensor, boolean front);
+    }
+
+    // Degrees past the halfway point between two turns before the turn changes, so a phone held near 45 degrees doesn't flicker
+    private static final int HYSTERESIS = 15;
+
+    private final SensorManager sensorManager;
+    private final int sensor;
+    private final boolean front;
+    private final Listener listener;
+    private int device = -1;
+
+    private WebcamOrientation(SensorManager sensorManager, int sensor, boolean front, Listener listener) {
+        this.sensorManager = sensorManager;
+        this.sensor = sensor;
+        this.front = front;
+        this.listener = listener;
+    }
+
+    /**
+     * Reports the camera at once with an unknown turn, then each turn the phone settles on. Without an accelerometer,
+     * only the first report is sent.
+     */
+    public static WebcamOrientation start(Handler handler, int sensor, boolean front, Listener listener) {
+        listener.onOrientation(-1, sensor, front);
+        SensorManager sensorManager = (SensorManager) FakeContext.get().getSystemService(Context.SENSOR_SERVICE);
+        Sensor accelerometer = sensorManager == null ? null : sensorManager.getDefaultSensor(Sensor.TYPE_ACCELEROMETER);
+        if (accelerometer == null) {
+            Ln.w("No accelerometer, the picture won't turn with the phone");
+            return null;
+        }
+        WebcamOrientation orientation = new WebcamOrientation(sensorManager, sensor, front, listener);
+        if (!sensorManager.registerListener(orientation, accelerometer, SensorManager.SENSOR_DELAY_UI, handler)) {
+            Ln.w("Could not read the accelerometer, the picture won't turn with the phone");
+            return null;
+        }
+        return orientation;
+    }
+
+    public void stop() {
+        sensorManager.unregisterListener(this);
+    }
+
+    @Override
+    public void onSensorChanged(SensorEvent event) {
+        float x = -event.values[0];
+        float y = -event.values[1];
+        float z = -event.values[2];
+        // Lying flat (tilted more than about 63 degrees from upright): no way up to tell
+        if ((x * x + y * y) * 4 < z * z) {
+            return;
+        }
+        int angle = 90 - Math.round((float) Math.toDegrees(Math.atan2(-y, x)));
+        angle = ((angle % 360) + 360) % 360;
+        if (device >= 0) {
+            int fromCurrent = Math.abs(((angle - device * 90 + 540) % 360) - 180);
+            if (fromCurrent < 45 + HYSTERESIS) {
+                return;
+            }
+        }
+        int turn = ((angle + 45) / 90) % 4;
+        if (turn != device) {
+            device = turn;
+            listener.onOrientation(device, sensor, front);
+        }
+    }

@@ -0,0 +1,30 @@
+package com.genymobile.scrcpy.video;
+
+/**
+ * Phone image controls added for the Closeup app.
+ * <p>
+ * A field left unset (NaN for the exposure, -1 for the others) keeps the camera default.
+ */
+public final class WebcamImage {
+
+    public static final String[] AWB_NAMES = {"auto", "daylight", "cloudy", "incandescent", "fluorescent"};
+    public static final String[] FOCUS_NAMES = {"continuous", "locked"};
+    public static final String[] LEVEL_NAMES = {"off", "fast", "high_quality"};
+
+    public static final int FOCUS_LOCKED = 1;
+
+    public float exposureEv = Float.NaN;
+    public int awb = -1;
+    public int focus = -1;
+    public int nr = -1;
+    public int edge = -1;
+
+    public static int parseName(String key, String value, String[] names) {
+        for (int i = 0; i < names.length; ++i) {
+            if (names[i].equals(value)) {
+                return i;
+            }
+        }
+        throw new IllegalArgumentException("Invalid value for " + key + ": \"" + value + "\"");
+    }
+}

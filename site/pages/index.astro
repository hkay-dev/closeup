---
import { Image } from "astro:assets";
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import liveControlsShot from "../content/images/live-controls.png";

const { config } = data;
const github = "https://github.com/hkay-dev/closeup";
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  page={{
    title: "Closeup: your Android phone, as your Mac's webcam",
    description: config.description,
    route: "/",
  }}
>
  <div class="page">
    <section aria-labelledby="title">
      <h1 id="title">
        <span>Plug in your phone.</span>
        <span>Click <em>Start Webcam.</em></span>
        <span>Pick <em>OBS Virtual Camera.</em></span>
      </h1>

      <div class="intro">
        <img src="/icon.svg" alt="" width="64" height="64" />
        <p>
          That's <strong>Closeup</strong>. Your Android phone becomes your Mac's webcam in Zoom, Meet,
          FaceTime, Teams or QuickTime. No app on the phone, no account, no cloud.
        </p>
        <div class="cta">
          <a class="btn" href="/install">Get started</a>
          <a class="docs" href="/introduction">Read the docs</a>
        </div>
      </div>
    </section>

    <section class="points" aria-label="What you get">
      <ul>
        <li>
          <strong>Skip the expensive webcam.</strong> Why spend hundreds of dollars when your phone
          already has terrific optics? Using it costs nothing.
        </li>
        <li>
          <strong>Wired or wireless.</strong> USB is the steadiest. Wi-Fi has been great too: pair once
          and it reconnects by itself.
        </li>
        <li>
          <strong>Every lens, any way up.</strong> Front or back camera, the ultra-wide instead of the
          main lens, and landscape, portrait or auto-rotate.
        </li>
        <li>
          <strong>As much picture as you want.</strong> From 1080p at 30 fps up to 4K at 60 and
          40 Mbps. Want to push it to 120 fps? Sure. Just know your phone will run warm.
        </li>
      </ul>
      <div class="shot">
        <Image
          src={liveControlsShot}
          width={280}
          densities={[1, 2]}
          alt="Closeup's Live Controls panel, with lens, zoom, flashlight, exposure, white balance and focus controls"
        />
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Questions</h2>

      <details>
        <summary>Is it free?</summary>
        <p>
          Not only is it free, it's fully open source under Apache-2.0. <a href={github}>See the code on GitHub</a>.
        </p>
      </details>

      <details>
        <summary>How does it work?</summary>
        <p>
          Closeup joins two excellent open-source tools, <a href="https://github.com/Genymobile/scrcpy">scrcpy</a> and <a href="https://obsproject.com">OBS</a>,
          into a virtual webcam that any app on your Mac
          can pick, as long as it asks for a camera. <a href="/how-it-works">More on how it works</a>.
        </p>
      </details>

      <details>
        <summary>Why can't I rename the camera?</summary>
        <p>
          The picture goes through OBS's virtual camera, and OBS decides the name that apps show. A
          camera with its own name needs a paid Apple Developer ID, which the project doesn't have yet.
        </p>
      </details>

      <details>
        <summary>What do I need?</summary>
        <p>
          A Mac on macOS 13 or later, an Android phone on Android 12 or later, and a USB cable that
          carries data. <a href="/requirements">Full requirements</a>.
        </p>
      </details>
    </section>
  </div>
</PageLayout>

<style>
  .page {
    margin: 0 auto;
    max-width: 68rem;
    padding: 7rem 1.5rem 7rem;
  }

  h1 {
    color: var(--blume-foreground);
    display: grid;
    font-family: var(--blume-font-display);
    font-size: clamp(2.5rem, 6.4vw, 5.5rem);
    font-weight: 600;
    gap: 0.06em;
    letter-spacing: -0.055em;
    line-height: 1;
    margin: 0;
  }

  h1 em {
    color: var(--blume-accent);
    font-style: normal;
  }

  .intro {
    align-items: start;
    border-top: 2px solid var(--blume-foreground);
    column-gap: 1.5rem;
    display: grid;
    grid-template-columns: 4rem minmax(0, 32rem) 1fr;
    margin-top: 5rem;
    padding-top: 2rem;
  }

  .intro img {
    height: 4rem;
    width: 4rem;
  }

  .intro p {
    color: var(--closeup-body);
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0;
  }

  .intro strong {
    color: var(--blume-foreground);
  }

  .cta {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    justify-self: end;
  }

  .btn {
    align-items: center;
    background: var(--blume-foreground);
    border-radius: 999px;
    color: var(--blume-background);
    display: inline-flex;
    font-family: var(--blume-font-display);
    font-size: 1.125rem;
    font-weight: 500;
    min-height: 3.5rem;
    padding: 0 2.25rem;
    text-decoration: none;
    transition: background-color 160ms ease-out;
  }

  .btn:hover {
    background: var(--blume-accent);
    color: var(--blume-accent-foreground);
  }

  a:not(.btn) {
    text-decoration-line: underline;
    color: var(--blume-foreground);
    text-decoration-color: color-mix(in oklab, var(--blume-accent) 70%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }

  a:not(.btn):hover {
    color: var(--blume-accent);
  }

  .docs {
    font-size: 0.9375rem;
  }

  /* Four short points, with the real Live Controls panel beside them. */
  .points {
    align-items: center;
    display: grid;
    gap: 4rem;
    grid-template-columns: minmax(0, 1fr) auto;
    margin-top: 8rem;
  }

  .points ul {
    display: grid;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .points li {
    border-left: 2px solid var(--blume-border);
    color: var(--closeup-body);
    font-size: 1.1875rem;
    line-height: 1.55;
    max-width: 36rem;
    padding-left: 1.25rem;
  }

  .points li strong {
    color: var(--blume-foreground);
    font-weight: 600;
  }

  .shot :global(img) {
    display: block;
    filter: drop-shadow(0 24px 40px rgb(28 27 25 / 0.2)) drop-shadow(0 1px 2px rgb(28 27 25 / 0.14));
    height: auto;
    max-width: 100%;
  }

  :global(:root[data-theme="dark"]) .shot :global(img) {
    filter: drop-shadow(0 24px 44px rgb(0 0 0 / 0.55)) drop-shadow(0 0 1px rgb(255 255 255 / 0.25));
  }

  /* FAQ */
  .faq {
    margin-top: 8rem;
    max-width: 44rem;
  }

  .faq h2 {
    color: var(--blume-foreground);
    font-family: var(--blume-font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    margin: 0 0 1.5rem;
  }

  details {
    border-top: 1px solid var(--blume-border);
  }

  details:last-of-type {
    border-bottom: 1px solid var(--blume-border);
  }

  summary {
    align-items: center;
    color: var(--blume-foreground);
    cursor: pointer;
    display: flex;
    font-size: 1.25rem;
    font-weight: 500;
    justify-content: space-between;
    letter-spacing: -0.02em;
    list-style: none;
    padding: 1.25rem 0;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* A plus that turns into a cross when open. */
  summary::after {
    display: inline-block;
    color: var(--blume-muted-foreground);
    content: "+";
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1;
    transition: transform 200ms ease-out;
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  summary:focus-visible {
    outline: 2px solid var(--blume-accent);
    outline-offset: 2px;
  }

  details p {
    color: var(--closeup-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    margin: 0 0 1.5rem;
    max-width: 38rem;
  }

  @media (max-width: 860px) {
    .page {
      padding-top: 4.5rem;
    }

    .intro {
      grid-template-columns: 3rem minmax(0, 1fr);
      row-gap: 2rem;
    }

    .intro img {
      height: 3rem;
      width: 3rem;
    }

    .cta {
      align-items: start;
      grid-column: 1 / -1;
      justify-self: start;
    }

    .points {
      gap: 3rem;
      grid-template-columns: minmax(0, 1fr);
      margin-top: 5rem;
    }

    .shot {
      justify-self: center;
    }

    .faq {
      margin-top: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    summary::after {
      transition: none;
    }
  }
</style>

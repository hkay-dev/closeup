---
import { Image } from "astro:assets";
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import liveControlsShot from "../content/images/live-controls.png";

const { config } = data;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  page={{
    title: "Closeup: your Android phone, as your Mac's webcam",
    description: config.description,
    route: "/",
  }}
>
  <div class="wall">
    <section class="hero" aria-labelledby="title">
      <figure class="work">
        <Image
          src={liveControlsShot}
          width={320}
          densities={[1, 2]}
          loading="eager"
          alt="Closeup's Live Controls panel: a Pixel 8 is ready, with a Start Webcam button and lens, zoom, flashlight, exposure, white balance and focus controls"
        />
      </figure>

      <div class="label">
        <h1 id="title">Closeup</h1>
        <p class="medium">Android phone and Mac, 2026.</p>
        <p>
          Your Android phone becomes your Mac's webcam in Zoom, Meet, FaceTime, Teams or QuickTime. No
          app on the phone, no account, no cloud.
        </p>
        <p class="medium">Free and open source. Needs macOS 13 and Android 12 or later.</p>
        <div class="cta">
          <a class="btn" href="/install">Download for Mac</a>
          <a class="docs" href="/introduction">Read the docs</a>
        </div>
      </div>
    </section>

    <section class="steps" aria-labelledby="steps-title">
      <h2 id="steps-title">Your first call</h2>
      <ol>
        <li>
          <strong>Plug in your phone.</strong>
          USB-C, or Wi-Fi once it's paired. Nothing to install on the phone.
        </li>
        <li>
          <strong>Click Start Webcam.</strong>
          It's in the menu bar. Setup walks you through the first time.
        </li>
        <li>
          <strong>Pick OBS Virtual Camera.</strong>
          In Zoom, Meet, FaceTime, Teams, QuickTime or any app that asks for a camera.
        </li>
        <li>
          <strong>Tune the picture.</strong>
          Front or back, any lens, any way up, from 1080p at 30 fps to 4K at 60.
        </li>
      </ol>
    </section>
  </div>
</PageLayout>

<style>
  /* One wall, one light from above. */
  .wall {
    isolation: isolate;
    overflow: clip;
    padding: clamp(3rem, 8svh, 6rem) 1.5rem clamp(5rem, 12svh, 9rem);
  }

  .hero {
    align-items: center;
    column-gap: clamp(3.5rem, 8vw, 8rem);
    display: grid;
    grid-template-columns: auto minmax(0, 22rem);
    justify-content: center;
    min-height: calc(100svh - 12rem);
  }

  .work {
    margin: 0;
    position: relative;
  }

  /* The spotlight on the wall, centered over the panel. */
  .work::before {
    aspect-ratio: 1;
    background: radial-gradient(
      closest-side,
      var(--closeup-light),
      color-mix(in oklab, var(--closeup-light) 55%, transparent) 40%,
      color-mix(in oklab, var(--closeup-light) 18%, transparent) 70%,
      transparent
    );
    content: "";
    left: 50%;
    pointer-events: none;
    position: absolute;
    top: -40%;
    transform: translateX(-50%);
    width: min(140vw, 64rem);
    z-index: -1;
  }

  .work :global(img) {
    display: block;
    filter: drop-shadow(0 32px 36px var(--closeup-shadow)) drop-shadow(0 2px 3px var(--closeup-shadow-near));
    height: auto;
    width: clamp(15rem, calc((100svh - 13rem) * 0.4194), 20rem);
  }

  :global(:root[data-theme="dark"]) .work :global(img) {
    filter: drop-shadow(0 32px 40px var(--closeup-shadow)) drop-shadow(0 0 1px rgb(255 255 255 / 0.22));
  }

  /* The wall label: one size, hierarchy by weight and ink. */
  .label {
    color: var(--closeup-body);
    font-size: clamp(1.0625rem, 0.95rem + 0.3vw, 1.25rem);
    line-height: 1.5;
  }

  .label h1 {
    color: var(--blume-foreground);
    font-family: var(--blume-font-body);
    font-size: inherit;
    font-weight: 600;
    letter-spacing: 0;
    line-height: inherit;
    margin: 0;
  }

  .label p {
    margin: 0;
    text-wrap: pretty;
  }

  .label .medium {
    color: var(--blume-muted-foreground);
  }

  .label h1 + .medium {
    margin-bottom: 1.25em;
  }

  .label p:not(.medium) + .medium {
    margin-top: 1.25em;
  }

  .cta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }

  .btn {
    align-items: center;
    background: var(--blume-accent);
    border-radius: 6px;
    color: var(--blume-accent-foreground);
    display: inline-flex;
    font-size: 1rem;
    font-weight: 500;
    min-height: 2.875rem;
    padding: 0 1.375rem;
    text-decoration: none;
    transition: background-color 160ms ease-out;
  }

  .btn:hover {
    background: color-mix(in oklab, var(--blume-accent) 84%, var(--blume-foreground));
  }

  .btn:focus-visible,
  .docs:focus-visible {
    outline: 2px solid var(--blume-accent);
    outline-offset: 3px;
  }

  .docs {
    color: var(--blume-foreground);
    font-size: 1rem;
    text-decoration-color: color-mix(in oklab, var(--blume-accent) 55%, transparent);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: color 150ms ease-out;
  }

  .docs:hover {
    color: var(--blume-accent);
  }

  /* Four small labels in the order a first call happens. */
  .steps {
    margin: clamp(4rem, 10svh, 7rem) auto 0;
    max-width: 68rem;
  }

  .steps h2 {
    color: var(--blume-foreground);
    font-family: var(--blume-font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    margin: 0 0 1.5rem;
  }

  .steps ol {
    counter-reset: step;
    display: grid;
    gap: 2rem clamp(1.5rem, 3vw, 3rem);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .steps li {
    border-top: 1px solid var(--blume-border);
    color: var(--blume-muted-foreground);
    counter-increment: step;
    font-size: 1rem;
    line-height: 1.55;
    padding-top: 1rem;
    text-wrap: pretty;
  }

  .steps li::before {
    color: var(--blume-muted-foreground);
    content: counter(step);
    display: block;
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.75rem;
  }

  .steps strong {
    color: var(--blume-foreground);
    display: block;
    font-weight: 600;
  }

  /* The light comes up once, over a page that's readable from the first frame. */
  @media (prefers-reduced-motion: no-preference) {
    .work::before {
      animation: lights-up 1400ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both;
    }

    @keyframes lights-up {
      from {
        opacity: 0;
      }
    }
  }

  @media (max-width: 900px) {
    .steps ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 22rem);
      min-height: 0;
      row-gap: 3.5rem;
    }

    .work {
      justify-self: center;
    }

    .work :global(img) {
      width: min(17.5rem, 72vw);
    }

    .work::before {
      top: -35%;
    }
  }

  @media (max-width: 520px) {
    .steps ol {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .docs {
      transition: none;
    }
  }
</style>
